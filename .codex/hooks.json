{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/format.cjs\" || true",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/format.ps1')\"",
            "timeout": 60,
            "statusMessage": "Formatting edited files with Prettier"
          }
        ]
      }
    ]
  }
}
